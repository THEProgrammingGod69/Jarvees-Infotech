# Canonical site origin. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.jarveesacademy.com

# --- Enquiry form delivery -------------------------------------------------
# The form posts to the internal route handler at /api/enquiry, which forwards
# to whichever provider is configured below. Configure exactly one.
#
# Option A — Formspree (no server key needed; the endpoint id is public):
NEXT_PUBLIC_FORMSPREE_ID=

# Option B — Resend (server-side only; never expose this with NEXT_PUBLIC_):
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=jarveesacademy.pune@gmail.com
ENQUIRY_FROM_EMAIL=enquiries@jarveesacademy.com

# If neither is configured the route handler logs the enquiry and returns
# success in development, and returns a 503 with a "call us instead" message
# in production. It never fails silently.
